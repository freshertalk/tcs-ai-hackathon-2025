# Apache / cPanel fallback.
# Ignored by Netlify, Cloudflare Pages, Vercel and GitHub Pages, so it is safe
# to ship alongside _headers and _redirects.

# --- correct MIME types ------------------------------------------------------
# sitemap.xml was being served as text/html, which makes browsers strip the
# tags and print the values as one run-on line.
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- SPA fallback ------------------------------------------------------------
# Retired addresses go home with a 301; real files and directories win;
# everything else falls back to index.html so /library, /books/… and /read/…
# work on a hard refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^(technical|writings)/?$ / [R=301,L]
  # the reader's own shell (see scripts/prerender.js)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^read/.+ /read/index.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# --- caching -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  # book metadata and chapters change when a book is replaced: always revalidate
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
