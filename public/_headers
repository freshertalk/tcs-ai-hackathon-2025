# Netlify / Cloudflare Pages header rules.
#
# Why this file exists: sitemap.xml was being served as text/html, so browsers
# stripped the tags and rendered it as a run-on paragraph. Search engines are
# more forgiving, but an explicit XML content type is the correct answer and
# makes the file inspectable in a browser.

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/humans.txt
  Content-Type: text/plain; charset=utf-8

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8

# Hashed build assets never change under the same name.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Baseline security headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
