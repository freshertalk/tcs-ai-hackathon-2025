# Copy to server/.env on the server and fill in. server/.env is git-ignored: never commit it.

# MongoDB: the server keeps its records (settings, admins, watchlist, trading switch and
# audit log, AI journal and reports) in this database. Leave MONGO_URI out to use files.
MONGO_URI=
MONGO_DB=stock-trading

# Two 32-byte keys that encrypt the stored secrets (Google, Kite, Anthropic) and sign the
# sign-in cookie. Make each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe: losing SETTINGS_KEY means typing those secrets in again.
# Left empty, the server creates them as files in server/data/ instead.
SETTINGS_KEY=
SESSION_SECRET=
