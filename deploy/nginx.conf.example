# nginx in front of the Node process (deploy/ecosystem.config.cjs, pm2 app "vinaytiwari",
# port 5100). Two ways to wire it; both work. Check either with:  stock-deploy --doctor
#
# THE SYMPTOM OF GETTING THIS WRONG: "Login with Google" lands on the home page. nginx is then
# answering /api/… with the site's own index.html (a "try_files … /index.html" fallback), so
# the request never reaches the app. Open https://your-domain/api/auth/status in a browser:
# it must show a line of JSON, not the site.
#
# ---------------------------------------------------------------------------------------
# A. Smallest change: nginx keeps serving the built site itself, and passes only /api and
#    /me to the app. Nothing existing is removed.
#
#      stock-deploy --nginx | sudo tee /etc/nginx/snippets/vinaytiwari-app.conf > /dev/null
#
#    then ONE line inside the site's HTTPS server block, above its "location / {" line:

server {
    listen 443 ssl;
    server_name vinaytiwari.org www.vinaytiwari.org;
    # ssl_certificate … ;  ssl_certificate_key … ;      (the lines Certbot wrote stay)

    root /home/YOUR-USER/tcs-ai-hackathon-2025/build;   # as it is today
    index index.html;

    include snippets/vinaytiwari-app.conf;              # <-- the one new line

    location / {
        try_files $uri /index.html;                     # as it is today
    }
}

#    sudo nginx -t && sudo systemctl reload nginx
#
#    Mind which block you edit: a site usually has two "server { … }" blocks, one for port
#    80 and one for port 443. The line belongs in the 443 one.
#
# ---------------------------------------------------------------------------------------
# B. Everything through the app: Node serves the site's files too (with long-lived caching
#    for the hashed ones), so nginx only terminates HTTPS and forwards. Replaces the
#    "root …/build" and "try_files" lines.
#
# server {
#     listen 443 ssl;
#     server_name vinaytiwari.org www.vinaytiwari.org;
#     # ssl_certificate … ;  ssl_certificate_key … ;
#
#     location / {
#         proxy_pass http://127.0.0.1:5100;            # no path after the port
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header Connection "";
#         proxy_buffering off;                          # the live streams must not be held back
#         proxy_read_timeout 1h;
#         client_max_body_size 8m;
#     }
# }
#
# Either way, plain HTTP goes to HTTPS:
#
# server {
#     listen 80;
#     server_name vinaytiwari.org www.vinaytiwari.org;
#     return 301 https://$host$request_uri;
# }
